# Generate a token at https://www.kaggle.com/settings/api.
KAGGLE_API_TOKEN=replace_with_your_kaggle_api_token

# Base directory for relative YAML data paths; empty uses the working directory.
# Example: DATA_PATH=D:/datasets makes the default raw path D:/datasets/data/raw.
# Also stores Hugging Face models/tokenizers in D:/datasets/huggingface/hub.
DATA_PATH=
