# Generate a token at https://www.kaggle.com/settings/api.
KAGGLE_API_TOKEN=replace_with_your_kaggle_api_token

# Optional directory for the persistent native Hugging Face Hub cache.
# Example: MODEL_PATH=D:/models stores Qwen/Qwen3-4B in D:/models/models--Qwen--Qwen3-4B/.
# Empty preserves standard Hugging Face cache settings. YAML data paths are independent.
MODEL_PATH=

# Directories for scripts/extract_qwen3_4b.py only.
# FILE_PATH contains Qwen3-4B-lora-minimal.zip; DATA_PATH receives the model cache.
# To load that cache afterward, set MODEL_PATH to the same directory as DATA_PATH.
FILE_PATH=
DATA_PATH=
