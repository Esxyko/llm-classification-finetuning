# Generate a token at https://www.kaggle.com/settings/api.
KAGGLE_API_TOKEN=replace_with_your_kaggle_api_token

# Optional base directory for downloads: Kaggle raw files and Hugging Face caches.
# Example: DATA_PATH=D:/datasets makes the default raw path D:/datasets/data/raw.
# Hugging Face models/tokenizers then use D:/datasets/huggingface/hub.
# Empty uses the working directory for raw files and standard Hugging Face caches.
# Generated data, training caches, checkpoints, and reports use working-directory paths.
DATA_PATH=
