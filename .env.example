# Generate a token at https://www.kaggle.com/settings/api.
KAGGLE_API_TOKEN=replace_with_your_kaggle_api_token

# Optional directory for downloaded Hugging Face model archives.
# Example: MODEL_PATH=D:/models stores Qwen/Qwen3-4B in D:/models/models--Qwen--Qwen3-4B.zip.
# Models unpack automatically into a private temporary cache while the process runs.
# Empty preserves standard Hugging Face cache settings. YAML data paths are independent.
MODEL_PATH=
